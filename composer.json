{
  "name": "andmemasin/yii2-emails-validator",
  "type": "project",
  "license":"MIT",
  "description": "A Yii2 module to do on-screen bulk validation of e-mails",
  "keywords": ["validation","yii2","email"],

  "authors": [
    {
      "name": "Tõnis Ormisson",
      "email": "tonis@andmemasin.eu"
    }
  ],

  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.3.0",
    "ext-intl": "*",
    "yiisoft/yii2": "~2.0.5",
    "egulias/email-validator": "^3|^4"
  },
  "require-dev": {
    "andmemasin/yii2-myabstract": "^10.0",
    "codeception/codeception": "^5.0",
    "codeception/module-filesystem": "^3.0.0",
    "codeception/module-yii2": "^1.1.7",
    "codeception/module-asserts": "^3.0.0",
    "codeception/module-db": "^3.0",
    "infection/codeception-adapter": "^0.4.7",
    "infection/infection": "^0.34",
    "phpstan/phpstan": "^1.8",
    "illuminate/container": "^11.0|^12.0",
    "illuminate/http": "^11.0|^12.0",
    "illuminate/routing": "^11.0|^12.0",
    "illuminate/support": "^11.0|^12.0",
    "illuminate/view": "^11.0|^12.0"
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    },
    "process-timeout": 1800,
    "fxp-asset": {
      "enabled": false
    },
    "allow-plugins": {
      "infection/extension-installer": true,
      "yiisoft/yii2-composer": true
    }
  },
  "suggest": {
    "illuminate/container": "Required only when using the optional Laravel adapter.",
    "illuminate/routing": "Required only when using the optional Laravel adapter."
  },
  "extra": {
    "bootstrap": "andmemasin\\emailsvalidator\\Bootstrap",
    "branch-alias": {
      "dev-master": "2.1.x-dev"
    }
  },

  "autoload": {
    "psr-4": {
      "andmemasin\\emailsvalidator\\": "src"
    }
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://asset-packagist.org"
    }
  ]
}
