{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"],
        "excludes": ["views"]
    },
    "timeout": 600,
    "threads": 1,
    "tmpDir": "tests/_output/infection",
    "testFramework": "codeception",
    "testFrameworkExtraArgs": "-c codeception.yml unit",
    "phpUnit": {
        "configDir": "."
    },
    "minCoveredMsi": 45,
    "maxTimeouts": 10,
    "logs": {
        "text": "tests/_output/infection.log",
        "summaryJson": "tests/_output/infection-summary.json"
    },
    "mutators": {
        "@default": true
    }
}
