{
  "openapi": "3.1.0",
  "info": {
    "title": "EmailsValidator API",
    "version": "1.0.0",
    "description": "Stateless e-mail address validation. The host application configures the maximum input size; the default is 128 KB (128 KiB)."
  },
  "servers": [
    {"url": "/api/v1", "description": "Laravel adapter (EmailValidationServiceProvider)"},
    {"url": "/emailsvalidator/api/v1", "description": "Yii adapter with the default emailsvalidator module ID"}
  ],
  "paths": {
    "/email-validations": {
      "post": {
        "operationId": "emailValidation.store",
        "security": [{"cookieAuth": []}],
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/EmailValidationRequest"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation completed.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/EmailValidationResponse"}
              }
            }
          },
          "422": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/EmailValidationErrorResponse"}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {"type": "apiKey", "in": "header", "name": "Cookie"}
    },
    "schemas": {
      "EmailValidationRequest": {
        "type": "object",
        "required": ["text_input", "check_dns", "check_spoof", "display_only_problems"],
        "properties": {
          "text_input": {"type": "string", "minLength": 1},
          "check_dns": {"type": "boolean", "default": true},
          "check_spoof": {"type": "boolean", "default": true},
          "display_only_problems": {"type": "boolean", "default": true}
        },
        "additionalProperties": false
      },
      "EmailValidationResult": {
        "type": "object",
        "required": ["address", "needs_trimming", "is_valid", "is_valid_rfc", "is_no_rfc_warnings", "is_valid_dns", "is_valid_spoof_check"],
        "properties": {
          "address": {"type": "string"},
          "needs_trimming": {"type": "boolean"},
          "is_valid": {"type": "boolean"},
          "is_valid_rfc": {"type": "boolean"},
          "is_no_rfc_warnings": {"type": "boolean"},
          "is_valid_dns": {"type": "boolean"},
          "is_valid_spoof_check": {"type": "boolean"}
        },
        "additionalProperties": false
      },
      "EmailValidationResponse": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": {
          "data": {"type": "array", "items": {"$ref": "#/components/schemas/EmailValidationResult"}},
          "meta": {
            "type": "object",
            "required": ["total", "failed", "display_only_problems"],
            "properties": {
              "total": {"type": "integer", "minimum": 0},
              "failed": {"type": "integer", "minimum": 0},
              "display_only_problems": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "EmailValidationErrorResponse": {
        "type": "object",
        "required": ["message", "errors"],
        "properties": {
          "message": {"type": "string", "const": "The given data was invalid."},
          "errors": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}}
        },
        "additionalProperties": false
      }
    }
  }
}
